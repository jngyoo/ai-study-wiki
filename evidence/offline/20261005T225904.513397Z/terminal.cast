[43.321, "o", "[class1:localhost-running-software-on-your-own-machine:1] vault/raw/class1.html / Localhost: Running Software on Your Own Machine\r\n"]
[43.321, "o", "Localhost: Running Software on Your Own Machine\r\n"]
[43.321, "o", "https://haas-ai-classes-fall-26.vercel.app/class1.html#/localhost-running-software-on-your-own-machine\r\n"]
[43.321, "o", "\r\n"]
[43.321, "o", "[class1:what-localhost-actually-means:1] vault/raw/class1.html / What localhost Actually Means\r\n"]
[43.321, "o", "What localhost Actually Means\r\n"]
[43.321, "o", "localhost is a name that always points back at the machine you are typing on. Its address is 127.0.0.1 \u2014 literally \u201cthis computer.\u201d\r\n"]
[43.321, "o", "Your browser asks for http://localhost:8000\r\n"]
[43.321, "o", "The request never touches the internet \u2014 no DNS, no wifi, no cable\r\n"]
[43.321, "o", "It goes from your browser to another program on your own laptop, and comes straight back\r\n"]
[43.321, "o", "Note\r\n"]
[43.321, "o", "This is why localhost still works on a plane with no wifi. You are the customer and the restaurant.\r\n"]
[43.321, "o", "https://haas-ai-classes-fall-26.vercel.app/class1.html#/what-localhost-actually-means\r\n"]
[43.321, "o", "\r\n"]
